# 복사해서 .env 로 사용 (cp .env.example .env && chmod 600 .env). 값은 채팅/이슈/커밋에 절대 붙여넣지 말 것.

# --- LLM ---
# 모델은 provider:model_id 형식. 정확한 ID는 `uv run python scripts/list_models.py` 로 조회.
MODEL_LIGHT=openai:<분류용 모델 ID>
MODEL_STANDARD=openai:<초안용 모델 ID>
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- LangSmith ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=mail-agent-dev
# 실제 메일을 처리할 때는 true 유지 (입출력 원문이 외부로 전송되지 않음).
# 합성 데이터로 평가/시연할 때만 false 로 바꿔 상세 trace 를 확인.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# --- Gmail (OAuth, 최소 권한: readonly + compose) ---
GMAIL_CLIENT_SECRET_FILE=.secrets/gmail_client_secret.json
GMAIL_TOKEN_FILE=.secrets/gmail_token.json
# 처리 대상 라벨 (비우면 INBOX 전체). 처음에는 전용 라벨로 좁혀서 시작 권장.
GMAIL_TARGET_LABEL=mail-agent

# --- Hermes gateway는 ~/.hermes/.env 에 별도 보관 (이 파일에 넣지 않음) ---

# --- 대시보드 API ---
# python3 -c "import secrets;print(secrets.token_urlsafe(32))" 로 생성
API_TOKEN=
